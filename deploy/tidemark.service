[Unit]
Description=Tidemark e-ink tide display refresh
# Render the tide ribbon once and push it to the IT8951 panel, then exit.
# Driven on a schedule by tidemark.timer.
After=multi-user.target

[Service]
Type=oneshot
# Runs as root: the IT8951 driver needs GPIO/SPI access via bcm2835.
# TIDEMARK_HOME is how the binary locates the project root (venv + renderer).
# __TIDEMARK_HOME__ is substituted with the install path by deploy.sh.
WorkingDirectory=__TIDEMARK_HOME__
Environment=TIDEMARK_HOME=__TIDEMARK_HOME__
ExecStart=__TIDEMARK_HOME__/build/tidemark
# A render+display is ~30s; if one ever hangs holding the SPI bus, kill it so
# the next cycle can recover instead of the display freezing.
RuntimeMaxSec=120

