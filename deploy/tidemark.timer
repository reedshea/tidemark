[Unit]
Description=Refresh the Tidemark display every 5 minutes

[Timer]
# Fire on the wall clock every 5 minutes. Within an hour only the now-marker
# moves, so those fires are tiny partial refreshes (flash confined to a narrow
# strip); on the hour the window scrolls and the host does a full crisp GC16
# repaint, which is self-cleaning and keeps ghosting from accumulating.
OnCalendar=*:0/5
# Also refresh shortly after boot so the panel isn't stale on startup.
OnBootSec=30s
AccuracySec=20s
Persistent=false

[Install]
WantedBy=timers.target
