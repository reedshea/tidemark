[Unit]
Description=Refresh the Tidemark display every 30 minutes

[Timer]
# Fire on the wall clock at :00 and :30. Each refresh is a full crisp GC16
# repaint (briefly flashes), so we keep the cadence low — the panel stays sharp
# and ghost-free and the flash is rarely caught.
OnCalendar=*:0/30
# Also refresh shortly after boot so the panel isn't stale on startup.
OnBootSec=30s
AccuracySec=20s
Persistent=false

[Install]
WantedBy=timers.target
